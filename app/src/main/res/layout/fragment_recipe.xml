<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/RecipeFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/title_height">

            <ImageView
                android:id="@+id/imRecipeImage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/title_height"
                android:contentDescription="@string/recipe_image"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRecipeTitle"
                style="@style/StyleTitleTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/padding_main"
                android:gravity="bottom|start"
                android:padding="@dimen/title_padding"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="Название рецепта очень длинное" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            style="@style/StyleTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_main"
            android:layout_marginTop="@dimen/padding_main"
            android:text="@string/ingredients_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_main"
            android:layout_marginTop="@dimen/subtitle_margin"
            android:orientation="horizontal">

            <TextView
                style="@style/StyleServingsNumber16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/servings_title" />

            <TextView
                android:id="@+id/tvServingsNumber"
                style="@style/StyleServingsNumber16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/subtitle_margin"
                android:text="@string/servings_number_default"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbServingsNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5"
            android:min="1"
            android:progress="1"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding_main"
            android:background="@drawable/rounded_background"
            android:paddingStart="@dimen/recipe_padding"
            android:paddingTop="@dimen/half_layout_margin"
            android:paddingEnd="@dimen/recipe_padding"
            android:paddingBottom="@dimen/half_layout_margin"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_ingredient" />

        <TextView
            style="@style/StyleTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_main"
            android:text="@string/method_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding_main"
            android:background="@drawable/rounded_background"
            android:paddingStart="@dimen/recipe_padding"
            android:paddingTop="@dimen/half_layout_margin"
            android:paddingEnd="@dimen/recipe_padding"
            android:paddingBottom="@dimen/half_layout_margin"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_method" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
